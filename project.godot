Horses="*res://scripts/horses.gd"
Camp="*res://scripts/camp.gd"
Fair="*res://scripts/fair.gd"
Airport="*res://scripts/airport.gd"
Detective="*res://scripts/detective.gd"
School="*res://scripts/school.gd"
Holidays="*res://scripts/holidays.gd"
