; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MyCity Online"
config/description="Arsa al, bahis oyna, poker oyna, balık tut, hastanede ve markette çalış."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/settings.gd"
Net="*res://scripts/net.gd"
Land="*res://scripts/land.gd"
Casino="*res://scripts/casino.gd"
Poker="*res://scripts/poker.gd"
Jobs="*res://scripts/jobs.gd"
Rpg="*res://scripts/rpg.gd"
Env="*res://scripts/env.gd"
Garage="*res://scripts/garage.gd"
Homes="*res://scripts/homes.gd"
Bazaar="*res://scripts/bazaar.gd"
Pets="*res://scripts/pets.gd"
Biz="*res://scripts/biz.gd"
Story="*res://scripts/story.gd"
Farm="*res://scripts/farm.gd"
Clans="*res://scripts/clans.gd"
Events="*res://scripts/events.gd"
Police="*res://scripts/police.gd"
Shops="*res://scripts/shops.gd"
Bank="*res://scripts/bank.gd"
Election="*res://scripts/election.gd"
Family="*res://scripts/family.gd"
Ach="*res://scripts/achievements.gd"
Football="*res://scripts/football.gd"
Langirt="*res://scripts/langirt.gd"
Seasonal="*res://scripts/seasonal.gd"
Work="*res://scripts/work.gd"
Party="*res://scripts/party.gd"
Tutorial="*res://scripts/tutorial.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.13, 0.15, 0.2, 1)
