[Unit]
Description=MyCity Online tarayıcı sürümü için Cloudflare tüneli (wss)
After=network-online.target mycity-sunucu.service

[Service]
ExecStart=%h/.local/bin/mycity-web-tunel.sh
Restart=always
RestartSec=10
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LC_ALL=C

[Install]
WantedBy=default.target
